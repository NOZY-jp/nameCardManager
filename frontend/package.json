{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f drizzle/0000_initial.sql -f drizzle/0001_add_lower_bigm_indexes.sql",
    "db:rollback": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f drizzle/0001_add_lower_bigm_indexes.down.sql -f drizzle/0000_initial.down.sql",
    "db:check-names": "node scripts/check-db-names.mjs",
    "docs:check-env": "node scripts/check-auth-env-docs.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.18",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "postgres": "^4.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "sass": "^1.97.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@playwright/test": "^1.40",
    "@testing-library/jest-dom": "^6.4",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3",
    "@vitest/coverage-v8": "^1.6",
    "axios-mock-adapter": "^2.0",
    "drizzle-kit": "^0.31.11",
    "jsdom": "^24.1",
    "msw": "^2.0",
    "typescript": "^5",
    "vitest": "^1.6"
  }
}
