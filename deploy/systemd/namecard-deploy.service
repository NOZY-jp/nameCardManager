[Unit]
Description=NameCard Manager deploy poll (fallback for missed webhooks)
Documentation=file:%h/nameCardManager/docs/DEPLOYMENT.md
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=%h/namecard-deploy
Environment=STATE_DIR=%h/namecard-deploy
ExecStart=%h/namecard-deploy/deploy.sh
TimeoutStartSec=3600
